# Production-like settings. Copy to .env.prod.local and replace EVERY change-me.
# .env.prod.local is git-ignored. Never commit real secrets.
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
BCRYPT_ROUNDS=12
MAIL_DRIVER=smtp
MAIL_FROM="Doctor Booking <you@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=change-me
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
LOG_LEVEL=info
SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true
TRUST_PROXY=0
CORS_ORIGINS=
