{
  "name": "doctor-booking-api",
  "version": "0.0.1",
  "private": true,
  "description": "Doctor appointment booking API",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest": "pnpm db:test:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "db:test:create": "docker compose exec -T postgres psql -U doctor -d postgres -c \"CREATE DATABASE doctor_booking_test\"",
    "db:test:migrate": "cross-env DATABASE_URL=postgresql://doctor:doctor@localhost:5432/doctor_booking_test prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "start:worker": "node dist/worker/main.js",
    "start:worker:dev": "nest start --watch --entryFile worker/main"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
