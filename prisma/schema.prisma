generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}


model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  email           String         @unique
  name            String
  role            Role           @default(PATIENT)
  isActive        Boolean        @default(true) @map("is_active")
  passwordHash    String?        @map("password_hash")
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  googleId        String?        @unique @map("google_id")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctorProfile DoctorProfile?
  appointments  Appointment[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Specialty {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors DoctorProfile[]

  @@map("specialties")
}

model Clinic {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  addressLine String   @map("address_line")
  city        String
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors DoctorProfile[]

  @@map("clinics")
}

model DoctorProfile {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  specialtyId     String   @map("specialty_id") @db.Uuid
  clinicId        String   @map("clinic_id") @db.Uuid
  bio             String   @default("")
  experienceYears Int      @default(0) @map("experience_years")
  slotDurationMin Int      @default(30) @map("slot_duration_min")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  availabilityRules AvailabilityRule[]
  timeOffs          TimeOff[]
  appointments      Appointment[]

  @@index([specialtyId])
  @@index([clinicId])
  @@map("doctor_profiles")
}

model AvailabilityRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("availability_rules")
}

model TimeOff {
  id          String   @id @default(uuid(7)) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  date        DateTime @db.Date
  startMinute Int?     @map("start_minute")
  endMinute   Int?     @map("end_minute")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@map("time_off")
}


model Appointment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  startAt            DateTime          @map("start_at") @db.Timestamptz(3)
  endAt              DateTime          @map("end_at") @db.Timestamptz(3)
  status             AppointmentStatus @default(CONFIRMED)
  reason             String?
  idempotencyKey     String            @map("idempotency_key")
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledByRole    Role?             @map("cancelled_by_role")
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient User          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([patientId, idempotencyKey])
  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  dedupeKey   String?   @unique @map("dedupe_key")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  seq       BigInt    @unique @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seq])
  @@index([userId, readAt])
  @@map("notifications")
}